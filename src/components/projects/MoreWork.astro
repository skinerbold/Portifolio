---
import { projects } from '../../data/projects'
import type { Project } from '../../types/project'
import Container from '../layout/Container.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import { assetPath } from '../../utils/assetPath'

const moreProjects: Project[] = projects
  .filter((project) => !project.featured)
  .sort((first, second) => (first.moreWorkOrder ?? Infinity) - (second.moreWorkOrder ?? Infinity))

if (moreProjects.length !== 5 || moreProjects.some((project) => project.moreWorkOrder === undefined)) {
  throw new Error('More Work requires exactly five ordered non-featured projects.')
}
---

<section class="more-work" id="mais-projetos" aria-labelledby="more-work-title">
  <Container class="more-work__container">
    <div class="more-work__marker grid-12">
      <Eyebrow><span class="more-work__index">03</span> / More work</Eyebrow>
      <span class="more-work__rule" aria-hidden="true"></span>
    </div>

    <div class="more-work__heading grid-12">
      <h2 id="more-work-title">
        <span>Outros</span>
        <span>projetos.</span>
      </h2>
    </div>

    <div class="more-work__list">
      {
        moreProjects.map((project) => (
          <article class="project-row" aria-labelledby={`${project.slug}-more-work-title`}>
            <div class="project-row__content">
              <p class="project-row__label mono-label">
                <span class="project-row__number">{String(project.moreWorkOrder).padStart(2, '0')}</span>
                <span aria-hidden="true">/</span>
                <span>Project</span>
              </p>

              <div class="project-row__main">
                <h3 id={`${project.slug}-more-work-title`}>{project.title}</h3>
                {project.shortDescription && <p class="project-row__description">{project.shortDescription}</p>}
              </div>

              {(project.period || project.technologies?.length) && (
                <div class="project-row__metadata" aria-label={`Informações do projeto ${project.title}`}>
                  {project.period && <span class="mono-label">{project.period.label}</span>}
                  {project.technologies?.length && (
                    <span class="mono-label">{project.technologies.join(' / ')}</span>
                  )}
                </div>
              )}

              <div class="project-row__links" aria-label={`Links de ${project.title}`}>
                {
                  project.links.website && (
                    <a href={project.links.website} target="_blank" rel="noopener noreferrer">
                      <span>Visitar</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )
                }
                {
                  project.links.github && (
                    <a href={project.links.github} target="_blank" rel="noopener noreferrer">
                      <span>Código</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  )
                }
              </div>
            </div>

            <figure class="project-row__preview" aria-hidden="true">
              <img
                src={assetPath(project.image.src)}
                alt=""
                width={project.image.width}
                height={project.image.height}
                loading="lazy"
                decoding="async"
              />
            </figure>
          </article>
        ))
      }
    </div>
  </Container>
</section>

<style>
  .more-work {
    background: var(--surface-soft);
    border-bottom: 1px solid var(--border);
    scroll-margin-top: var(--site-header-height);
  }

  .more-work :global(.more-work__container) {
    padding-block: clamp(4.5rem, 8vw, 7.5rem);
  }

  .more-work__marker {
    align-items: center;
  }

  .more-work__marker :global(.eyebrow) {
    grid-column: 1 / span 3;
  }

  .more-work__index,
  .project-row__number {
    color: var(--accent);
  }

  .more-work__rule {
    grid-column: 4 / -1;
    height: 1px;
    background: var(--border);
  }

  .more-work__heading {
    margin-block: clamp(2.75rem, 6vw, 5.5rem) clamp(3rem, 6vw, 5rem);
  }

  h2 {
    grid-column: 1 / span 7;
    font-size: clamp(3rem, 2.05rem + 3.45vw, 4.85rem);
    font-weight: 540;
    letter-spacing: -0.06em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  h2 span {
    display: block;
  }

  .more-work__list {
    max-width: 75rem;
    border-top: 1px solid var(--foreground);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(16rem, 25vw, 23rem);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    padding-block: clamp(2.25rem, 4vw, 3.75rem);
    border-bottom: 1px solid var(--border);
  }

  .project-row__content {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(0.8rem, 1.7vw, 1.5rem);
    row-gap: clamp(0.9rem, 1.5vw, 1.35rem);
    align-items: start;
  }

  .project-row__label {
    display: flex;
    grid-column: 1 / span 2;
    gap: 0.5rem;
    align-items: baseline;
    padding-top: 0.35rem;
    color: var(--muted);
  }

  .project-row__main {
    display: grid;
    grid-column: 3 / span 6;
    gap: clamp(0.8rem, 1.3vw, 1.15rem);
  }

  h3 {
    font-size: clamp(1.75rem, 1.25rem + 1.85vw, 3rem);
    font-weight: 540;
    letter-spacing: -0.052em;
    line-height: 0.94;
    text-transform: uppercase;
  }

  .project-row__description {
    max-width: 31rem;
    font-size: clamp(0.98rem, 0.94rem + 0.2vw, 1.08rem);
    letter-spacing: -0.012em;
    line-height: 1.45;
  }

  .project-row__metadata {
    display: grid;
    grid-column: 10 / -1;
    gap: var(--space-2);
    color: var(--muted);
  }

  .project-row__links {
    display: flex;
    grid-column: 3 / span 6;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .project-row__links a {
    position: relative;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 2.5rem;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 520;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .project-row__links a::after {
    position: absolute;
    right: 0;
    bottom: 0.3rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .project-row__preview {
    width: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.35rem);
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .project-row__preview img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-row:hover h3,
  .project-row:focus-within h3,
  .project-row:hover .project-row__links a,
  .project-row:focus-within .project-row__links a {
    color: var(--accent);
  }

  .project-row:hover .project-row__links a::after,
  .project-row:focus-within .project-row__links a::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .project-row:hover .project-row__preview,
  .project-row:focus-within .project-row__preview {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  @media (max-width: 74.99rem) {
    .project-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .project-row__preview {
      display: none;
    }
  }

  @media (max-width: 47.99rem) {
    .more-work :global(.more-work__container) {
      padding-block: clamp(4.5rem, 17vw, 7rem);
    }

    .more-work__marker :global(.eyebrow) {
      grid-column: 1 / span 2;
    }

    .more-work__rule {
      grid-column: 3 / -1;
    }

    .more-work__heading {
      margin-top: clamp(2.75rem, 13vw, 4.5rem);
      margin-bottom: clamp(3.25rem, 13vw, 5rem);
    }

    h2 {
      grid-column: 1 / -1;
      font-size: clamp(2.75rem, 12.5vw, 4.1rem);
    }

    .project-row {
      padding-block: clamp(2.5rem, 10vw, 3.5rem);
    }

    .project-row__content {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: var(--space-4);
    }

    .project-row__label,
    .project-row__main,
    .project-row__metadata,
    .project-row__links {
      grid-column: 1 / -1;
    }

    .project-row__label {
      padding-top: 0;
    }

    h3 {
      font-size: clamp(2rem, 9.8vw, 3.35rem);
    }

    .project-row__description {
      font-size: clamp(1rem, 4.5vw, 1.17rem);
    }
  }
</style>
