---
import { profile } from '../../data/profile'
import { socialLinks } from '../../data/socialLinks'
import Container from './Container.astro'
import Eyebrow from '../ui/Eyebrow.astro'

const emailLink = socialLinks.find((link) => link.platform === 'email' && link.href)
const emailAddress = emailLink?.href?.startsWith('mailto:')
  ? emailLink.href.slice('mailto:'.length)
  : undefined
const contactLinks = socialLinks.filter((link) => link.platform !== 'email' && link.href)
const currentYear = new Date().getFullYear()
---

<section class="contact" id="contato" aria-labelledby="contact-title">
  <Container class="contact__container">
    <div class="contact__marker grid-12">
      <Eyebrow>
        <span class="contact__index">05</span> / CONTATO
      </Eyebrow>
      <span class="contact__rule" aria-hidden="true"></span>
    </div>

    <div class="contact__intro grid-12">
      <h2 class="contact__title" id="contact-title">
        <span>Vamos</span>
        <span>conversar?</span>
      </h2>

      <div class="contact__support">
        <p class="contact__prompt">Tem uma ideia, projeto ou oportunidade?</p>
        <p class="contact__description">
          Estou disponível para conversar sobre novos trabalhos, colaborações e soluções em tecnologia.
        </p>
      </div>
    </div>

    {
      emailLink?.href && emailAddress && (
        <address class="contact__email">
          <span class="mono-label">E-mail</span>
          <a class="contact__email-link" href={emailLink.href}>
            <span>{emailAddress}</span>
            <span class="contact__arrow" aria-hidden="true">↗</span>
          </a>
        </address>
      )
    }

    {
      contactLinks.length > 0 && (
        <nav class="contact__social" aria-label="Outros canais de contato">
          <ul class="contact__social-list">
            {contactLinks.map((link) => (
              <li>
                <a
                  href={link.href!}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >
                  <span>{link.label}</span>
                  <span class="contact__arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <footer class="contact__footer">
      <span>© {currentYear} {profile.name}</span>
      <span>Viçosa / MG</span>
    </footer>
  </Container>
</section>

<style>
  .contact {
    background: var(--surface);
    scroll-margin-top: var(--site-header-height);
  }

  .contact :global(.contact__container) {
    padding-block: clamp(4.5rem, 7vw, 7rem) clamp(3rem, 5vw, 4.5rem);
  }

  .contact__marker {
    align-items: center;
  }

  .contact__marker :global(.eyebrow) {
    grid-column: 1 / span 3;
  }

  .contact__index {
    color: var(--accent);
  }

  .contact__rule {
    grid-column: 4 / -1;
    height: 1px;
    background: var(--border);
  }

  .contact__intro {
    margin-top: clamp(2.75rem, 5vw, 4.75rem);
    align-items: center;
  }

  .contact__title {
    grid-column: 1 / span 5;
    max-width: 32rem;
    font-size: clamp(3.15rem, 4.5vw, 4.75rem);
    font-weight: 540;
    letter-spacing: -0.075em;
    line-height: 0.87;
    text-transform: uppercase;
  }

  .contact__title span {
    display: block;
  }

  .contact__support {
    grid-column: 8 / span 4;
    max-width: 30rem;
    padding-top: 0.2rem;
  }

  .contact__prompt,
  .contact__description {
    max-width: 31rem;
    letter-spacing: -0.018em;
  }

  .contact__prompt {
    font-size: clamp(1.1rem, 1rem + 0.35vw, 1.35rem);
    line-height: 1.4;
  }

  .contact__description {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-body);
    line-height: 1.5;
  }

  .contact__email {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: baseline;
    margin: clamp(3.75rem, 6vw, 5.5rem) 0 0;
    padding-block: clamp(1.5rem, 2.5vw, 2.25rem);
    font-style: normal;
    border-top: 1px solid var(--border);
  }

  .contact__email > span {
    grid-column: 1 / span 7;
    grid-row: 1;
    color: var(--muted);
  }

  .contact__email-link {
    display: inline-flex;
    grid-column: 1 / span 7;
    grid-row: 2;
    gap: 0.65rem;
    align-items: baseline;
    width: fit-content;
    max-width: 100%;
    margin-top: var(--space-3);
    color: var(--foreground);
    font-size: clamp(1.45rem, 2.15vw, 2.45rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .contact__arrow {
    flex: 0 0 auto;
    display: inline-block;
    transition: transform 180ms ease;
  }

  .contact__social {
    padding-block: clamp(1.4rem, 2.25vw, 2rem);
    border-top: 1px solid var(--border);
  }

  .contact__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem clamp(2rem, 4vw, 4.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__social a {
    position: relative;
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    min-height: 2rem;
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 520;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .contact__social a::after,
  .contact__email-link::after {
    position: absolute;
    right: 0;
    bottom: -0.18rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 180ms ease;
  }

  .contact__email-link {
    position: relative;
  }

  .contact__email-link:hover,
  .contact__email-link:focus-visible,
  .contact__social a:hover,
  .contact__social a:focus-visible {
    color: var(--accent);
  }

  .contact__email-link:hover::after,
  .contact__email-link:focus-visible::after,
  .contact__social a:hover::after,
  .contact__social a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .contact__email-link:hover .contact__arrow,
  .contact__email-link:focus-visible .contact__arrow,
  .contact__social a:hover .contact__arrow,
  .contact__social a:focus-visible .contact__arrow {
    transform: translate(0.16rem, -0.16rem);
  }

  .contact__footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding-top: var(--space-4);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 520;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
    border-top: 1px solid var(--border);
  }

  .contact__footer span:last-child {
    text-align: right;
  }

  @media (max-width: 62.5rem) {
    .contact__title {
      grid-column: 1 / span 6;
    }

    .contact__support {
      grid-column: 8 / -1;
    }

  }

  @media (max-width: 47.99rem) {
    .contact :global(.contact__container) {
      padding-block: clamp(4.25rem, 14vw, 5.5rem) clamp(2.75rem, 10vw, 4rem);
    }

    .contact__marker :global(.eyebrow) {
      grid-column: 1 / span 2;
    }

    .contact__rule {
      grid-column: 3 / -1;
    }

    .contact__intro {
      margin-top: clamp(2.5rem, 10vw, 3.5rem);
      align-items: start;
    }

    .contact__title,
    .contact__support {
      grid-column: 1 / -1;
    }

    .contact__title {
      max-width: 20rem;
      font-size: clamp(3rem, 12.2vw, 4.25rem);
      line-height: 0.89;
    }

    .contact__support {
      margin-top: clamp(2rem, 8vw, 3rem);
    }

    .contact__email {
      display: block;
      margin-top: clamp(3.25rem, 12vw, 4.5rem);
    }

    .contact__email-link {
      display: flex;
      margin-top: var(--space-3);
      font-size: clamp(1.4rem, 6.3vw, 2rem);
    }

    .contact__social-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.35rem 1.5rem;
    }

    .contact__social a {
      min-height: 2.5rem;
    }

    .contact__footer {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .contact__footer span:nth-child(2),
    .contact__footer span:last-child {
      text-align: left;
    }
  }

  @media (max-width: 22rem) {
    .contact__social-list {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__email-link,
    .contact__social a,
    .contact__arrow,
    .contact__email-link::after,
    .contact__social a::after {
      transition: none;
    }
  }
</style>
