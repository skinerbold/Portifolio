---
import Container from './Container.astro'
import { profile } from '../../data/profile'
import { assetPath } from '../../utils/assetPath'
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <Container class="hero__container">
    <div class="hero__grid grid-12">
      <div class="hero__copy">
        <h1 id="hero-title">
          <span class="headline-line">Engineering,</span>
          <span class="headline-line">Software &amp;</span>
          <span class="headline-line">
            Intelligent <span class="headline-tail">Systems.</span>
          </span>
        </h1>

        <p class="hero__introduction">
          Desenvolvo soluções que conectam engenharia, software e tecnologia.
        </p>

        <a class="hero__cta mono-label" href="#projetos">
          <span>Ver projetos</span>
          <span class="hero__cta-arrow" aria-hidden="true">↓</span>
        </a>
      </div>

      <figure class="hero__portrait">
        <img
          src={assetPath(profile.image.src)}
          alt={profile.image.alt}
          width={profile.image.width}
          height={profile.image.height}
          fetchpriority="high"
        />
      </figure>

      <p class="hero__availability mono-label">
        <span class="availability-dot" aria-hidden="true"></span>
        Aberto a oportunidades
      </p>

      <div class="hero__metadata" aria-label="Localização e versão do portfólio">
        <span class="mono-label">Viçosa / MG / Brasil</span>
        <span class="mono-label">Portfolio / 2026</span>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    background: var(--background);
    border-bottom: 1px solid var(--border);
  }

  .hero :global(.hero__container) {
    display: flex;
    min-height: max(36rem, calc(100svh - var(--site-header-height)));
    padding-top: clamp(1.75rem, 4vh, 3.75rem);
  }

  .hero__grid {
    flex: 1;
    grid-template-rows: auto minmax(0, 1fr) auto;
    row-gap: clamp(1rem, 2.4vh, 2.25rem);
  }

  .hero__copy {
    grid-row: 2;
    grid-column: 1 / span 8;
    align-self: center;
  }

  h1 {
    max-width: none;
    font-size: clamp(3.5rem, 4.7vw, 5.35rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .headline-line {
    display: block;
  }

  .hero__introduction {
    max-width: 34rem;
    margin-top: clamp(1.75rem, 3.5vh, 3rem);
    font-size: clamp(1.05rem, 0.95rem + 0.45vw, 1.35rem);
    line-height: 1.35;
  }

  .hero__cta {
    position: relative;
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    min-height: 2.75rem;
    margin-top: clamp(1.5rem, 3.5vh, 2.75rem);
    color: var(--foreground);
    text-decoration: none;
  }

  .hero__cta::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transition: background-color 220ms ease;
  }

  .hero__cta-arrow {
    transition: transform 220ms ease;
  }

  .hero__cta:hover .hero__cta-arrow,
  .hero__cta:focus-visible .hero__cta-arrow {
    transform: translateY(0.2rem);
  }

  .hero__portrait {
    position: relative;
    grid-row: 2;
    grid-column: 9 / -1;
    align-self: end;
    justify-self: end;
    width: 100%;
    max-width: 29rem;
    height: clamp(24rem, 58svh, 38rem);
    margin: 0;
    isolation: isolate;
  }

  .hero__portrait::before {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 78%;
    height: 74%;
    background: var(--surface);
    content: '';
    z-index: -2;
  }

  .hero__portrait::after {
    position: absolute;
    top: 13%;
    right: 7%;
    width: 0.2rem;
    height: 31%;
    background: var(--accent);
    content: '';
    z-index: -1;
  }

  .hero__portrait img {
    position: absolute;
    bottom: 0;
    left: 50%;
    display: block;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translateX(-50%);
  }

  .hero__availability {
    display: inline-flex;
    grid-row: 1;
    grid-column: 1 / span 5;
    gap: var(--space-2);
    align-items: center;
    width: fit-content;
    color: var(--muted);
  }

  .availability-dot {
    width: 0.48rem;
    height: 0.48rem;
    flex: 0 0 auto;
    background: var(--accent);
    border-radius: 50%;
  }

  .hero__metadata {
    display: flex;
    grid-row: 3;
    grid-column: 1 / -1;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: clamp(0.9rem, 1.8vh, 1.25rem);
    color: var(--muted);
    border-top: 1px solid var(--border);
  }

  .hero__metadata span:first-child::before {
    display: inline-block;
    width: 1.35rem;
    height: 1px;
    margin-right: 0.65rem;
    vertical-align: middle;
    background: var(--accent);
    content: '';
  }

  @media (max-width: 64rem) and (min-width: 48rem) {
    .hero__copy {
      grid-column: 1 / span 7;
    }

    .hero__portrait {
      grid-column: 8 / -1;
      height: clamp(22rem, 55svh, 31rem);
    }

    h1 {
      font-size: clamp(3.5rem, 6.2vw, 4.35rem);
    }
  }

  @media (min-width: 48rem) and (max-height: 46rem) {
    .hero :global(.hero__container) {
      padding-top: var(--space-4);
    }

    .hero__grid {
      row-gap: var(--space-3);
    }

    .hero__introduction {
      margin-top: var(--space-4);
    }

    .hero__cta {
      margin-top: var(--space-3);
    }

  }

  @media (max-width: 47.99rem) {
    .hero :global(.hero__container) {
      min-height: auto;
      padding-top: clamp(2.25rem, 9vw, 4rem);
    }

    .hero__grid {
      flex: none;
      width: 100%;
      grid-template-rows: repeat(4, auto);
      row-gap: clamp(1.5rem, 5vw, 2.25rem);
    }

    .hero__copy {
      grid-row: 1;
      grid-column: 1 / -1;
      padding-bottom: 0;
    }

    h1 {
      font-size: clamp(2.85rem, 12vw, 4.2rem);
      line-height: 0.89;
    }

    .headline-tail {
      display: block;
    }

    .hero__introduction {
      max-width: 27rem;
      margin-top: clamp(1.75rem, 7vw, 2.5rem);
      font-size: clamp(1rem, 4.4vw, 1.2rem);
    }

    .hero__cta {
      margin-top: var(--space-4);
    }

    .hero__portrait {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-self: center;
      max-width: 23rem;
      height: clamp(20.5rem, 92vw, 26rem);
    }

    .hero__portrait::before {
      width: 80%;
      height: 72%;
    }

    .hero__portrait::after {
      top: 11%;
      right: 9%;
      height: 29%;
    }

    .hero__availability {
      grid-row: 3;
      grid-column: 1 / -1;
    }

    .hero__metadata {
      grid-row: 4;
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 23rem) {
    .hero__metadata {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
